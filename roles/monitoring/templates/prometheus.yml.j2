global:
  scrape_interval: 15s

rule_files:
  - "/etc/prometheus/alert_rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "localhost:9093"

scrape_configs:
  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - "{{ host }}:9100"
{% endfor %}